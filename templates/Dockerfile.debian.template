# ==============================================================================
# EOL-PHP-SecAuto: Debian Multi-Stage C-Patch Compilation Template
# ==============================================================================

ARG BASE_IMAGE=php:7.4-fpm
ARG PHP_VERSION=7.4

FROM debian:bullseye-slim AS builder
ARG PHP_VERSION
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential autoconf bison re2c git patch curl ca-certificates \
    libxml2-dev libssl-dev libsqlite3-dev zlib1g-dev libcurl4-openssl-dev

WORKDIR /usr/src
RUN curl -fsSL "https://www.php.net/distributions/php-${PHP_VERSION}.33.tar.gz" -o php.tar.gz || \
    curl -fsSL "https://museum.php.net/php7/php-${PHP_VERSION}.33.tar.gz" -o php.tar.gz || \
    curl -fsSL "https://www.php.net/distributions/php-${PHP_VERSION}.0.tar.gz" -o php.tar.gz

RUN tar -xzf php.tar.gz && mv php-${PHP_VERSION}.* php-src

WORKDIR /usr/src/php-src
COPY patches/php-${PHP_VERSION}/php-${PHP_VERSION}-enhanced-universal.patch /tmp/patch.diff
RUN patch -p1 < /tmp/patch.diff

RUN ./configure --prefix=/usr/local --enable-mbstring --with-openssl --with-curl && \
    make -j$(nproc)

# --- Final Lean Production Image ---
FROM ${BASE_IMAGE}

LABEL maintainer="Anton Barinov <https://github.com/Anton-Barinov>"
LABEL security.hardened="true"
LABEL security.patcher="EOL-PHP-SecAuto"

COPY --from=builder /usr/src/php-src/sapi/cli/php /usr/local/bin/php
COPY --from=builder /usr/src/php-src/sapi/fpm/php-fpm /usr/local/sbin/php-fpm 2>/dev/null || true

# Baseline Security Directives
RUN set -eux; \
    ini_dir=$(php -r 'echo php_ini_loaded_file() ? dirname(php_ini_loaded_file()) : "/usr/local/etc/php/conf.d";'); \
    mkdir -p "$ini_dir"; \
    { \
        echo '; EOL-PHP-SecAuto Hardening'; \
        echo 'session.upload_progress.enabled = Off'; \
        echo 'allow_url_include = Off'; \
        echo 'expose_php = Off'; \
        echo 'phar.readonly = On'; \
    } > "$ini_dir/99-eol-secauto-hardening.ini"

ENV EOL_SECAUTO_PATCHED=1
